CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
CONFIG_TARGET_rockchip_armv8_DEVICE_friendlyarm_nanopi-r2s=y

CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_TARGET_ROOTFS_PARTSIZE=822

CONFIG_ALL_KMODS=y
CONFIG_DEVEL=y

# CONFIG_KERNEL_WERROR is not set

CONFIG_KERNEL_BUILD_DOMAIN="buildhost"
CONFIG_KERNEL_BUILD_USER="builder"

CONFIG_COLLECT_KERNEL_DEBUG=y
CONFIG_REPRODUCIBLE_DEBUG_INFO=y

CONFIG_PACKAGE_r8152-firmware=y
CONFIG_PACKAGE_trusted-firmware-a-rk3328=y

CONFIG_TOOLCHAINOPTS=y

CONFIG_ZLIB_OPTIMIZE_SPEED=y

CONFIG_PACKAGE_kmod-hwmon-pwmfan=y
CONFIG_PACKAGE_addition-trans-zh=y
CONFIG_PACKAGE_autocore-arm=y
CONFIG_PACKAGE_ethtool=y

CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_ipset=y
# CONFIG_PACKAGE_dnsmasq_full_broken_rtc is not set
# CONFIG_PACKAGE_dnsmasq is not set

CONFIG_PACKAGE_kmod-fs-f2fs=y

CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-services=y
CONFIG_PACKAGE_ddns-scripts-cloudflare=y
CONFIG_PACKAGE_ddns-scripts-dnspod=y
CONFIG_PACKAGE_ddns-scripts-aliyun=y
CONFIG_PACKAGE_bind-host=y

# CONFIG_PACKAGE_firewall is not set
CONFIG_PACKAGE_firewall4=y

CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nft-fullcone=y

CONFIG_PACKAGE_arptables-nft=y
CONFIG_PACKAGE_ebtables-nft=y
CONFIG_PACKAGE_ip6tables-nft=y
CONFIG_PACKAGE_xtables-nft=y
CONFIG_PACKAGE_iptables-nft=y

CONFIG_PACKAGE_iptables-mod-conntrack-extra=y
CONFIG_PACKAGE_iptables-mod-iprange=y
CONFIG_PACKAGE_iptables-mod-nat-extra=y
CONFIG_PACKAGE_iptables-mod-socket=y
CONFIG_PACKAGE_iptables-mod-tproxy=y

CONFIG_PACKAGE_miniupnpd-nftables=y
CONFIG_PACKAGE_nat6=y

CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_LUCI_LANG_en=y

CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-nginx=y
CONFIG_PACKAGE_rpcd=y
CONFIG_PACKAGE_iw=y

CONFIG_PACKAGE_luci-app-passwall=y

CONFIG_PACKAGE_luci-proto-wireguard=y


CONFIG_PACKAGE_luci-app-sqm=y

CONFIG_PACKAGE_luci-app-upnp=y

CONFIG_PACKAGE_luci-app-watchcat=y

CONFIG_PACKAGE_luci-app-ksmbd=y
CONFIG_PACKAGE_ksmbd-server=y

CONFIG_PACKAGE_luci-app-filemanager=y

CONFIG_PACKAGE_luci-app-cpufreq=y

CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_qrencode=y

CONFIG_PACKAGE_kmod-mt7601u=y
CONFIG_PACKAGE_mt7601u-firmware=y

CONFIG_PACKAGE_kmod-mt76x2u=y
CONFIG_PACKAGE_kmod-mt76x2-common=y

CONFIG_PACKAGE_kmod-rtw88-usb=y
CONFIG_PACKAGE_kmod-rtw88-8811cu=y
CONFIG_PACKAGE_rtw88-firmware=y

CONFIG_PACKAGE_kmod-rtl8812au-ct=y

CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_r8152-firmware=y

CONFIG_PACKAGE_usbmuxd=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-ipheth=y

CONFIG_PACKAGE_kmod-tcp-bbr=y

CONFIG_PACKAGE_kmod-shortcut-fe-cm=y
CONFIG_PACKAGE_kmod-fast-classifier=y

CONFIG_OPENSSL_ENGINE=y
CONFIG_OPENSSL_OPTIMIZE_SPEED=y
CONFIG_OPENSSL_WITH_ASM=y

# CONFIG_OPENSSL_WITH_ERROR_MESSAGES is not set

CONFIG_PACKAGE_libopenssl-conf=y
CONFIG_PACKAGE_libopenssl-devcrypto=y
CONFIG_PACKAGE_libopenssl-legacy=y
CONFIG_PACKAGE_libcurl=y

CONFIG_LIBCURL_OPENSSL=y
